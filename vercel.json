{
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/$",
      "dest": "/frontend/index.html"
    },
    {
      "src": "^/loading$",
      "dest": "/frontend/loading.html"
    },
    {
      "src": "^/pages/([a-zA-Z0-9_-]+)$",
      "dest": "/frontend/pages/$1.html"
    },
    {
      "src": "^/pages/(.*)$",
      "dest": "/frontend/pages/$1"
    },
    {
      "src": "^/css/(.*)$",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "^/js/(.*)$",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
